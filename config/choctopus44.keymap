#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt { tapping-term-ms = <200>; };
&lt { tapping-term-ms = <200>; };

/ {
  conditional_layers {
    compatible = "zmk,conditional-layers";
    adjust { if-layers = <1 2>; then-layer = <4>; };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      bindings = <
&kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T               &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G               &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp CAPS  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp DEL    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mt RSHFT RET
      &mt LCTRL HOME  &lt 3 END  &lt 1 SPACE  &lt 2 RET       &kp BSPC  &mt RSHFT RET  &kp RALT  &kp RGUI
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    num {
      bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5             &none  &none  &none  &none  &kp SQT    &trans
&trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0             &none  &none  &none  &none  &kp SQT    &trans
&trans  &none   &none   &none   &none   &none    &trans    &none  &none  &none  &none  &kp MINUS  &trans
                    &trans  &trans  &trans  &trans             &kp DEL  &kp RSHFT  &kp RALT  &kp RCTRL
      >;
      sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
    };

    sym {
      bindings = <
&trans  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT             &none  &kp PLUS   &mt RSHFT GRAVE  &kp LBKT  &kp RBKT  &trans
&trans  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR              &none  &kp EQUAL  &kp TILDE        &kp LBRC  &kp RBRC  &trans
&trans  &none      &kp BSPC  &none     &none     &none      &trans     &none  &none      &none            &kp PIPE  &kp BSLH  &trans
                       &trans  &trans  &trans  &trans                     &kp DEL  &mt LSHFT HOME  &kp RALT  &kp RCTRL
      >;
      sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
    };

    nav {
      bindings = <
&trans  &kp C_AC_BACK  &kp LEFT  &kp UP    &kp RIGHT  &kp C_AC_FORWARD             &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &mkp RCLK  &trans
&trans  &kp TAB        &kp LALT  &kp DOWN  &kp PG_UP  &none                        &none      &kp RSHFT       &mmv MOVE_DOWN  &none            &none      &trans
&trans  &none          &none     &none     &kp PG_DN  &none            &kp BSPC    &none      &none           &none           &none            &none      &trans
                          &trans  &trans  &trans  &trans                              &kp DEL  &mt RSHFT HOME  &kp END  &none
      >;
      sensor-bindings = <&inc_dec_kp UP DOWN>;
    };

    system {
      bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &none  &none  &none  &none  &none  &studio_unlock
&none       &out OUT_USB  &out OUT_BLE  &none         &none         &none                   &none  &none  &none  &none  &none  &none
&none       &none         &none         &none         &none         &none        &none      &none  &none  &none  &none  &none  &sys_reset
                                 &bootloader  &trans  &trans  &trans                            &trans  &trans  &trans  &bootloader
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
